{
  "_conventions": {
    "purpose": "Ground truth for evaluation. Never edit this file to match model output.",
    "substance_ids": "Substance names exactly as in the active EU RoHS rule pack (rules/packs/eu_rohs/).",
    "near_limit": "NEAR_LIMIT when concentration >= 80% of the limit and <= the limit.",
    "unverifiable_vs_missing": "UNVERIFIABLE when a value is given as text that cannot be compared to a limit (trace amounts, N/A, <LOD). MISSING_CONCENTRATION when no value is given at all.",
    "exemption": "A substance with an exemption claim gets EXEMPTION_CLAIMED instead of OVER_LIMIT, so the declaration routes to human review (Medium) rather than High. The finding still shows the value against the base limit. Whether an exemption is valid is a human judgment.",
    "risk_rating": "Any OVER_LIMIT = High. Else any MISSING_CAS, MISSING_CONCENTRATION, UNVERIFIABLE or EXEMPTION_CLAIMED = Medium. Else NEAR_LIMIT only = Low with watch flag. Else Low. NOT_DECLARED is ignored for rating.",
    "not_declared": "NOT_DECLARED (severity Info) for each restricted substance in the active pack that the declaration does not address at all. A substance listed with a vague or missing value counts as addressed. NOT_DECLARED never changes the risk rating; it feeds the 'please confirm' list in the follow-up email.",
    "severity": {
      "OVER_LIMIT": "High",
      "MISSING_CAS": "Medium",
      "MISSING_CONCENTRATION": "Medium",
      "UNVERIFIABLE": "Medium",
      "EXEMPTION_CLAIMED": "Medium",
      "NEAR_LIMIT": "Low",
      "NOT_DECLARED": "Info"
    }
  },
